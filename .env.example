# Telegram / Bot

# DB
DATABASE_URL=postgresql+psycopg://mailer:mailer@localhost:5432/mailer
# For local no-docker dev you can also use sqlite:

# Logging
LOG_LEVEL=INFO
LOG_TO_FILES=1
LOG_RETENTION_DAYS=14

# Optional proxy to Telegram (http://user:pass@host:port or socks5://...)
TG_PROXY=

# API auth (for logs API, future send API)
API_LOG_AUTH_TOKEN=supersecret
